# =============================================================================
# Cortex Platform Auth — APIM OAuth2 client-credentials
# =============================================================================
APIM_TENANT_ID=<azure_tenant_guid>
APIM_CLIENT_ID=<service_principal_client_id>
APIM_CLIENT_SECRET=<service_principal_client_secret>
APIM_SCOPE=<api://your-app-id/.default>
# Optional: override the token endpoint. Defaults to:
#   https://login.microsoftonline.com/{APIM_TENANT_ID}/oauth2/v2.0/token
# APIM_TOKEN_URL=

# Cortex Agent / Deployment Name
CORTEX_AGENT_NAME=testing125

# Cortex OpenAI-compatible gateway
CORTEX_OPENAI_BASE=https://gateway.apim.lilly.com/cortex/cortex-openai
CORTEX_API_VERSION=2023-05-15

# Optional generation defaults
CORTEX_TEMPERATURE=0.0
CORTEX_MAX_TOKENS=4096

# Evaluation Thresholds (0–1 scale)
PASS_THRESHOLD=0.85
WARN_THRESHOLD=0.70
