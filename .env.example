# Cortex Platform Auth (Cookie for local dev)
CORTEX_COOKIE=<your_cortex_cookie_here>

# Cortex Agent Name (Claude Opus 4 agent configured in Cortex UI)
CORTEX_AGENT_NAME=claude-v20

# Cortex API URLs (defaults shown)
CORTEX_API_BASE=https://cortex.lilly.com
CORTEX_OPENAI_BASE=https://gateway.apim.lilly.com/cortex/cortex-openai

# Optional: AWS Auth for production (set to true to use AWS SigV4 instead of cookie)
USE_AWS_AUTH=false

# Optional: MSAL/Azure AD Auth
# CORTEX_CLIENT_ID=
# CORTEX_CLIENT_SECRET=
# CORTEX_AUTHORITY=
# CORTEX_SCOPE=

# Evaluation Thresholds
PASS_THRESHOLD=0.85
WARN_THRESHOLD=0.70
